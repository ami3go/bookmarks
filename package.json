{
  "name": "cockpit-bookmarks",
  "version": "0.7.1",
  "private": true,
  "description": "Cockpit plugin for bookmarks to services hosted on the same machine",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "node tests-ui/run.mjs"
  },
  "dependencies": {
    "@patternfly/patternfly": "6.6.1",
    "@patternfly/react-core": "6.6.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  }
}
